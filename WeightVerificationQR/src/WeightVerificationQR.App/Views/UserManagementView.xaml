<UserControl x:Class="WeightVerificationQR.App.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="User Management" Style="{StaticResource HeaderText}"/>
                <TextBlock Text="Create and manage Admin, Supervisor and Operator accounts" Style="{StaticResource SubHeaderText}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ New User" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,16,0" Padding="0">
                <DataGrid ItemsSource="{Binding Users}" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="2*"/>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
                        <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                        <DataGridTemplateColumn Header="" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="2"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Deactivate" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="2"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <StackPanel DataContext="{Binding EditingUser}">
                        <TextBlock Text="FULL NAME" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="USERNAME" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <TextBlock Text="ROLE" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  SelectedItem="{Binding Role}" Margin="0,0,0,14"/>

                        <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,0,0,14"/>
                    </StackPanel>

                    <TextBlock Text="NEW PASSWORD (leave blank to keep current)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,14" PasswordChanged="NewPasswordBox_PasswordChanged"/>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button Content="Save User" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
