<UserControl x:Class="WeightVerificationQR.App.Views.PassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- PASS Screen: shown while DashboardViewModel.DisplayState == Pass. Green, full result summary. -->
    <Border CornerRadius="10" Background="{StaticResource SuccessLightBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="110" Height="110" CornerRadius="55" Background="{StaticResource SuccessBrush}" HorizontalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="PASS" FontSize="52" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0">
                <Run Text="{Binding LastRecord.WeightKg, StringFormat='{}{0:0.000}'}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Run Text=" kg" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
            </TextBlock>

            <TextBlock Text="{Binding LastRecord.ProductName}" FontSize="14.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>

            <Border Background="#FFFFFF" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" Margin="0,12,0,0">
                <TextBlock Text="{Binding LastRecord.KitNumber}" FontSize="17" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="QR label sent to printer" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
