<UserControl x:Class="WeightVerificationQR.App.Views.MachineSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Machine Settings" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Configure the weighing indicator's serial (RS232 / USB) connection" Style="{StaticResource SubHeaderText}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" MaxWidth="520" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="COM PORT" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}" Text="{Binding PortName}" IsEditable="True"/>
                    <Button Grid.Column="1" Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshPortsCommand}" Margin="8,0,0,0" Padding="10,6"/>
                </Grid>

                <TextBlock Text="BAUD RATE" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="STABLE READING COUNT (consecutive matching samples)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding StableReadingCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="STABILITY TOLERANCE (kg)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding StabilityToleranceKg, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <TextBlock Text="RESET WEIGHT THRESHOLD (kg)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                <TextBox Text="{Binding ResetWeightThresholdKg, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Padding="10,4" CornerRadius="12" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LastTestResult}" Value="Connected">
                                        <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding LastTestResult}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Test Connection" Style="{StaticResource SecondaryButton}" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0"/>
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
