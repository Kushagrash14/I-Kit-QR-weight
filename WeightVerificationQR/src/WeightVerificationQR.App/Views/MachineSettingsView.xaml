<UserControl x:Class="WeightVerificationQR.App.Views.MachineSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Machine Settings" Style="{StaticResource HeaderText}"/>
                <TextBlock Text="Configure the weighing indicator's serial (RS232 / USB) connection" Style="{StaticResource SubHeaderText}" Margin="0,3,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" MaxWidth="560" HorizontalAlignment="Left" Padding="22">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Serial Connection" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <TextBlock Text="COM PORT" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}" Text="{Binding PortName}" IsEditable="True"/>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshPortsCommand}" Margin="8,0,0,0" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Refresh" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Text="BAUD RATE" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="STABLE READING COUNT (consecutive matching samples)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding StableReadingCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="STABILITY TOLERANCE (KG)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding StabilityToleranceKg, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="RESET WEIGHT THRESHOLD (KG)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ResetWeightThresholdKg, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Padding="12,5" CornerRadius="13" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastTestResult}" Value="Connected">
                                            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0"
                                         Fill="{Binding LastTestResult, Converter={StaticResource ConnectionStatusToBrushConverter}}"/>
                                <TextBlock Text="{Binding LastTestResult}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12,9" Margin="0,0,0,16"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5"/>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Test Connection"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Save"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
