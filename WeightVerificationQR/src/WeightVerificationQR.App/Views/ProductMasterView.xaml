<UserControl x:Class="WeightVerificationQR.App.Views.ProductMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Product Master" Style="{StaticResource HeaderText}"/>
                <TextBlock Text="Configure products and their acceptable weight ranges" Style="{StaticResource SubHeaderText}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ New Product" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,16,0" Padding="0">
                <DataGrid ItemsSource="{Binding Products}" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="*"/>
                        <DataGridTextColumn Header="Min (kg)" Binding="{Binding MinWeightKg, StringFormat=0.000}" Width="*"/>
                        <DataGridTextColumn Header="Max (kg)" Binding="{Binding MaxWeightKg, StringFormat=0.000}" Width="*"/>
                        <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                        <DataGridTemplateColumn Header="" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="2"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Deactivate" Style="{StaticResource SecondaryButton}" Padding="10,4" Margin="2"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel DataContext="{Binding EditingProduct}">
                    <TextBlock Text="PRODUCT NAME" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="QUANTITY (e.g. 100 Nos)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="MINIMUM WEIGHT (kg)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding MinWeightKg, UpdateSourceTrigger=PropertyChanged, StringFormat=0.000}" Margin="0,0,0,14"/>

                    <TextBlock Text="MAXIMUM WEIGHT (kg)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding MaxWeightKg, UpdateSourceTrigger=PropertyChanged, StringFormat=0.000}" Margin="0,0,0,14"/>

                    <TextBlock Text="KIT NUMBER PREFIX" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding CodePrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,0,0,20"/>

                    <TextBlock Text="{Binding DataContext.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button Content="Save Product" Style="{StaticResource PrimaryButton}"
                            Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
