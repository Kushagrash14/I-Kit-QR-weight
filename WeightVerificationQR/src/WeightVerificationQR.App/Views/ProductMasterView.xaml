<UserControl x:Class="WeightVerificationQR.App.Views.ProductMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Product Master" Style="{StaticResource HeaderText}"/>
                <TextBlock Text="Configure products and their acceptable weight ranges" Style="{StaticResource SubHeaderText}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="New Product"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="410"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,18,0" Padding="0">
                <DataGrid ItemsSource="{Binding Products}" IsReadOnly="True" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PRODUCT NAME" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="COMMAND" Binding="{Binding CommandCode}" Width="85"/>
                        <DataGridTextColumn Header="LINE" Binding="{Binding LabelLineCode}" Width="75"/>
                        <DataGridTextColumn Header="MODEL CODE" Binding="{Binding ModelCode}" Width="*"/>
                        <DataGridTextColumn Header="MIN (KG)" Binding="{Binding MinWeightKg, StringFormat=0.000}" Width="*"/>
                        <DataGridTextColumn Header="MAX (KG)" Binding="{Binding MaxWeightKg, StringFormat=0.000}" Width="*"/>
                        <DataGridTemplateColumn Header="STATUS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Inactive"/>
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active"/>
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Edit" Style="{StaticResource GhostButton}" Margin="2,0"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Deactivate" Style="{StaticResource GhostDangerButton}" Margin="2,0"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Product Details" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel DataContext="{Binding EditingProduct}">
                        <TextBlock Text="PRODUCT NAME" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="COMMAND" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding CommandCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0">
                                <TextBlock Text="LINE CODE" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding LabelLineCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                <TextBlock Text="MODEL CODE" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding ModelCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="LABEL SIZE / MODEL TEXT" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding LabelSizeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,7,0">
                                <TextBlock Text="LENGTH TEXT" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding LabelLengthText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="MATERIAL TEXT" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding LabelMaterialText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="QUANTITY / PACK INFO" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,7,0">
                                <TextBlock Text="MIN WEIGHT (KG)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MinWeightKg, UpdateSourceTrigger=PropertyChanged, StringFormat=0.000}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <TextBlock Text="MAX WEIGHT (KG)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding MaxWeightKg, UpdateSourceTrigger=PropertyChanged, StringFormat=0.000}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="KIT NUMBER PREFIX" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding CodePrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                        <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,0,0,18"/>
                    </StackPanel>

                    <Border Background="{StaticResource DangerLightBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,12"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12"/>
                    </Border>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Save Product"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
