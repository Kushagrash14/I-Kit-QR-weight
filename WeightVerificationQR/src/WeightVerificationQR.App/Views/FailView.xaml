<UserControl x:Class="WeightVerificationQR.App.Views.FailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- FAIL Screen: shown while DashboardViewModel.DisplayState == Fail. Red, shows rejection reason, no QR. -->
    <Border CornerRadius="10" Background="{StaticResource DangerLightBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="110" Height="110" CornerRadius="55" Background="{StaticResource DangerBrush}" HorizontalAlignment="Center">
                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="FAIL" FontSize="52" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0">
                <Run Text="{Binding LastRecord.WeightKg, StringFormat='{}{0:0.000}'}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Run Text=" kg" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"/>
            </TextBlock>

            <TextBlock Text="{Binding LastRecord.ProductName}" FontSize="14.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>

            <Border Background="#FFFFFF" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LastRecord.Remarks}" FontSize="16" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <TextBlock Text="&#xE8D8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="QR / label NOT generated" FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
