<UserControl x:Class="WeightVerificationQR.App.Views.PrinterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Printer Settings" Style="{StaticResource HeaderText}"/>
                <TextBlock Text="Connect BarTender to the installed label printer"
                           Style="{StaticResource SubHeaderText}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" MaxWidth="1180" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="22" Margin="0,0,9,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <TextBlock Text="&#xE8FE;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Printer Connection"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="PRINTER"
                                   Style="{StaticResource CardTitleText}"
                                   Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding InstalledPrinters}"
                                      Text="{Binding BarTenderPrinterName, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      Margin="0,0,8,0"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshPrintersCommand}"
                                    Width="42"
                                    Padding="0"
                                    ToolTip="Refresh installed printers">
                                <TextBlock Text="&#xE72C;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="PRINT METHOD"
                                   Style="{StaticResource CardTitleText}"
                                   Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding PrintMethods}"
                                  SelectedItem="{Binding BarTenderPrintMethod}"
                                  Margin="0,0,0,18"/>

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="8"
                                Padding="12,9"
                                Margin="0,0,0,16"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12.5"/>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestConnectionCommand}"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,7,0"/>
                                    <TextBlock Text="Test Printer"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,7,0"/>
                                    <TextBlock Text="Save"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                    <Border Style="{StaticResource CardBorder}" Padding="22">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <TextBlock Text="&#xE7C1;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="BarTender Setup"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Text="BARTENDER API URL"
                                       Style="{StaticResource CardTitleText}"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding BarTenderApiUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="LABEL TEMPLATE (.BTW)"
                                       Style="{StaticResource CardTitleText}"
                                       Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding BarTenderLabelPath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseTemplateCommand}"
                                        Padding="12,0"
                                        ToolTip="Select BarTender template">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0"/>
                                        <TextBlock Text="Browse"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Text="BARTENDER.EXE PATH"
                                       Style="{StaticResource CardTitleText}"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding BarTenderExePath, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0" Padding="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="Database Backup"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Create a timestamped backup copy of the production database."
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12.5"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BackupNowCommand}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Margin="0,0,7,0"/>
                                    <TextBlock Text="Backup Now"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
