<UserControl x:Class="WeightVerificationQR.App.Views.PrinterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Printer Settings" Style="{StaticResource HeaderText}"/>
                <TextBlock Text="Configure the Zebra / TSC / Godex label printer" Style="{StaticResource SubHeaderText}"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="PRINTER TYPE" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding PrinterTypes}" SelectedItem="{Binding PrinterType}" Margin="0,0,0,14"/>

                    <TextBlock Text="CONNECTION MODE" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ConnectionModes}" SelectedItem="{Binding ConnectionMode}" Margin="0,0,0,14"/>

                    <TextBlock Text="IP ADDRESS (Network mode)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="PORT (Network mode)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="COM PORT (USB/Serial mode)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="WINDOWS PRINTER NAME (Print-queue mode)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding WindowsPrinterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="LABEL WIDTH (mm)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding LabelWidthMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="LABEL HEIGHT (mm)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding LabelHeightMm, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Test Printer" Style="{StaticResource SecondaryButton}" Command="{Binding TestConnectionCommand}" Margin="0,0,10,0"/>
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,16,0,0" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="BARTENDER PRINTING (Connection Mode = BarTender)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>

                    <TextBlock Text="BARTENDER API URL" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding BarTenderApiUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="BARTENDER PRINTER NAME" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding BarTenderPrinterName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="LABEL TEMPLATE PATH (.btw)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding BarTenderLabelPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="BARTENDER.EXE PATH (leave blank to auto-detect)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding BarTenderExePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                    <TextBlock Text="PRINT METHOD (api / cmd / auto)" Style="{StaticResource CardTitleText}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding BarTenderPrintMethod, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,16,0,0" MaxWidth="560" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="DATABASE BACKUP" Style="{StaticResource CardTitleText}"/>
                        <TextBlock Text="Create a timestamped backup copy of the production database." TextWrapping="Wrap" MaxWidth="380" Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Content="Backup Now" Style="{StaticResource PrimaryButton}" Command="{Binding BackupNowCommand}" VerticalAlignment="Top"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
