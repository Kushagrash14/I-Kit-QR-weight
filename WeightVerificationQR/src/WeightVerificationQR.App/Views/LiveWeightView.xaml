<UserControl x:Class="WeightVerificationQR.App.Views.LiveWeightView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Live Weight Screen: shown while DashboardViewModel.DisplayState is Live or Idle.
        Bindings resolve against the DashboardViewModel that hosts this control
        (see DashboardView.xaml, which sets this as the content for those states).
    -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="LIVE WEIGHT" HorizontalAlignment="Center" Style="{StaticResource CardTitleText}"/>
        <TextBlock Text="{Binding LiveWeight, StringFormat='{}{0:0.000} kg'}" FontSize="72" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10"/>

        <Border Padding="16,6" CornerRadius="14" HorizontalAlignment="Center" Background="{StaticResource SuccessLightBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStable}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="Stable" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
        </Border>

        <TextBlock Text="Place the kit on the scale and hold steady" HorizontalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,20,0,0"/>
    </StackPanel>
</UserControl>
