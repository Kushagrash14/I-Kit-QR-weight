<UserControl x:Class="WeightVerificationQR.App.Views.QrReprintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="QR Reprint" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Search a previously PASSed kit by QR ID and reprint its label" Style="{StaticResource SubHeaderText}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" MaxWidth="560" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding QrIdInput, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="0,0,10,0"/>
                    <Button Content="Search" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding FoundRecord, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding FoundRecord.KitNumber}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding FoundRecord.ProductName}" Margin="0,4,0,0"/>
                    <TextBlock Margin="0,8,0,0">
                        <Run Text="Weight:"/>
                        <Run Text="{Binding FoundRecord.WeightKg, StringFormat=0.000}"/>
                        <Run Text="kg"/>
                    </TextBlock>
                    <TextBlock Text="{Binding FoundRecord.Result}" Foreground="{Binding FoundRecord.Result, Converter={StaticResource WeighResultToBrushConverter}}" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Margin="0,4,0,0">
                        <Run Text="Original date:"/>
                        <Run Text="{Binding FoundRecord.DateText}"/>
                        <Run Text="{Binding FoundRecord.TimeText}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding FoundRecord.ReprintCount, StringFormat='Reprint count: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                    <Button Content="Reprint Label" Style="{StaticResource PrimaryButton}" Command="{Binding ReprintCommand}" Margin="0,16,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
