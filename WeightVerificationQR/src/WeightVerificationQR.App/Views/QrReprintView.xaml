<UserControl x:Class="WeightVerificationQR.App.Views.QrReprintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="QR Reprint" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Search a previously PASSed kit by QR ID and reprint its label" Style="{StaticResource SubHeaderText}" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" MaxWidth="600" HorizontalAlignment="Left">
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding QrIdInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" MinHeight="40"
                             FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" MinHeight="40">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Search"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding FoundRecord, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding FoundRecord.KitNumber}" FontSize="20" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                            <TextBlock Text="{Binding FoundRecord.ProductName}" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="10" Padding="12,4" VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FoundRecord.Result}" Value="Pass">
                                            <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding FoundRecord.Result}" FontWeight="Bold" FontSize="12.5"
                                       Foreground="{Binding FoundRecord.Result, Converter={StaticResource WeighResultToBrushConverter}}"/>
                        </Border>
                    </Grid>

                    <Separator Margin="0,14" Background="{StaticResource BorderBrush2}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WEIGHT" Style="{StaticResource CardTitleText}"/>
                            <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold">
                                <Run Text="{Binding FoundRecord.WeightKg, StringFormat=0.000}"/>
                                <Run Text="kg" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ORIGINAL DATE" Style="{StaticResource CardTitleText}"/>
                            <TextBlock Margin="0,4,0,0" FontSize="13.5">
                                <Run Text="{Binding FoundRecord.DateText}"/>
                                <Run Text="{Binding FoundRecord.TimeText}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="REPRINT COUNT" Style="{StaticResource CardTitleText}"/>
                            <TextBlock Text="{Binding FoundRecord.ReprintCount}" Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ReprintCommand}" Margin="0,18,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Reprint Label"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" MaxWidth="500"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
