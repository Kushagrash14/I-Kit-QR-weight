<UserControl x:Class="WeightVerificationQR.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Reports" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Daily, monthly, operator-wise and product-wise reporting with Excel / PDF export" Style="{StaticResource SubHeaderText}" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,18" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="0">
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="FROM DATE" Style="{StaticResource CardTitleText}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Width="140"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="TO DATE" Style="{StaticResource CardTitleText}" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Width="140"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="PRODUCT" Style="{StaticResource CardTitleText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding ProductFilter, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="OPERATOR" Style="{StaticResource CardTitleText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding OperatorFilter, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="QR ID" Style="{StaticResource CardTitleText}" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding QrIdFilter, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SearchCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Search"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Excel"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ExportPdfCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="PDF"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Summary -->
        <Grid Grid.Row="2" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,9,0">
                <StackPanel>
                    <TextBlock Text="TOTAL RECORDS" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValueText}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="9,0">
                <StackPanel>
                    <TextBlock Text="PASS %" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Foreground="{StaticResource SuccessBrush}" Style="{StaticResource MetricValueText}">
                        <Run Text="{Binding PassPercent, Mode=OneWay}"/><Run Text="%"/>
                    </TextBlock>
                    <TextBlock Text="{Binding PassCount, StringFormat='{}{0} kits'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="9,0">
                <StackPanel>
                    <TextBlock Text="FAIL %" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Foreground="{StaticResource DangerBrush}" Style="{StaticResource MetricValueText}">
                        <Run Text="{Binding FailPercent, Mode=OneWay}"/><Run Text="%"/>
                    </TextBlock>
                    <TextBlock Text="{Binding FailCount, StringFormat='{}{0} kits'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="9,0,0,0">
                <StackPanel>
                    <TextBlock Text="STATUS" Style="{StaticResource CardTitleText}"/>
                    <TextBlock Text="{Binding StatusMessage, TargetNullValue='Ready'}" TextWrapping="Wrap" FontSize="12.5" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Grid -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0">
            <DataGrid ItemsSource="{Binding Records}" IsReadOnly="True" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="KIT NUMBER" Binding="{Binding KitNumber}" Width="1.3*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="SERIAL" Binding="{Binding SerialNumber}" Width="*"/>
                    <DataGridTextColumn Header="SITE" Binding="{Binding SiteCode}" Width="0.7*"/>
                    <DataGridTextColumn Header="LINE" Binding="{Binding LineCode}" Width="0.7*"/>
                    <DataGridTextColumn Header="MACHINE" Binding="{Binding MachineCode}" Width="0.8*"/>
                    <DataGridTextColumn Header="PRODUCT" Binding="{Binding ProductName}" Width="2*"/>
                    <DataGridTextColumn Header="WEIGHT (KG)" Binding="{Binding WeightKg, StringFormat=0.000}" Width="*"/>
                    <DataGridTemplateColumn Header="RESULT" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Result}" Value="Pass">
                                                    <Setter Property="Background" Value="{StaticResource SuccessLightBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Result}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding Result, Converter={StaticResource WeighResultToBrushConverter}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="REASON" Binding="{Binding Remarks}" Width="1.4*"/>
                    <DataGridTextColumn Header="DATE" Binding="{Binding DateText}" Width="*"/>
                    <DataGridTextColumn Header="TIME" Binding="{Binding TimeText}" Width="*"/>
                    <DataGridTextColumn Header="OPERATOR" Binding="{Binding OperatorName}" Width="1.2*"/>
                    <DataGridTextColumn Header="PRINTER" Binding="{Binding PrinterStatus}" Width="*"/>
                    <DataGridTextColumn Header="SYNC" Binding="{Binding SyncStatus}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
