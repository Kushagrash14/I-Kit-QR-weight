<Window x:Class="WeightVerificationQR.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:vm="clr-namespace:WeightVerificationQR.App.ViewModels"
        xmlns:views="clr-namespace:WeightVerificationQR.App.Views"
        Title="Weight Verification &amp; QR Label System"
        Icon="/Resources/app.ico"
        Height="860" Width="1420"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MinHeight="700" MinWidth="1100">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductMasterViewModel}">
            <views:ProductMasterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MachineSettingsViewModel}">
            <views:MachineSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrinterSettingsViewModel}">
            <views:PrinterSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QrReprintViewModel}">
            <views:QrReprintView/>
        </DataTemplate>

        <!-- Sidebar navigation item: icon + label, accent bar when active (light enterprise style) -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Tag" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <Grid>
                                <Border x:Name="activeBar" Width="3.5" HorizontalAlignment="Left" Margin="0,8"
                                        CornerRadius="2" Background="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <!-- Active page: Tag carries a boxed bool from StringEqualsConverter -->
                            <Trigger Property="Tag">
                                <Trigger.Value>
                                    <sys:Boolean>True</sys:Boolean>
                                </Trigger.Value>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                <Setter TargetName="activeBar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar (light enterprise) ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <Border DockPanel.Dock="Top" Padding="22,26,20,22" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WVQR" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Weight Verification" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- User chip + logout (bottom) -->
                <Border DockPanel.Dock="Bottom" Padding="14,14,14,18" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource PrimaryLightBrush}">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LoggedInUserName}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12.5"
                                               TextTrimming="CharacterEllipsis" MaxWidth="130"/>
                                    <TextBlock Text="{Binding LoggedInUserRole}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Command="{Binding LogoutCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="8" Padding="12,9" Background="{TemplateBinding Background}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Logout" FontSize="12.5" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerLightBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Nav items -->
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="OPERATIONS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="28,6,0,6"/>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                            Tag="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Dashboard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Dashboard"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Reports"
                            Tag="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Reports}"
                            Visibility="{Binding IsSupervisorOrAbove, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Reports"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="QrReprint"
                            Tag="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=QrReprint}"
                            Visibility="{Binding IsSupervisorOrAbove, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="QR Reprint"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="ADMINISTRATION" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="28,16,0,6"
                               Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="ProductMaster"
                            Tag="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ProductMaster}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Product Master"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="UserManagement"
                            Tag="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=UserManagement}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="User Management"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="MachineSettings"
                            Tag="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=MachineSettings}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Machine Settings"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="PrinterSettings"
                            Tag="{Binding CurrentPage, Converter={StaticResource StringEqualsConverter}, ConverterParameter=PrinterSettings}"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FE;" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Printer Settings"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
